{
  "expo": {
    "name": "myst",
    "slug": "myst",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/1024.png",
    "scheme": "myst",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo/1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#092328"
    },
    "ios": {
      "icon": "./assets/images/logo/1024.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.veed.mys",
      "infoPlist": {
        "RCTUseAssetCatalog": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/1024.png",
        "backgroundImage": "./assets/images/logo/512.png",
        "monochromeImage": "./assets/images/logo/1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veed.mys"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/512.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3F2FD",
          "image": "./assets/images/logo/1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#092328",
            "image": "./assets/images/logo/1024.png"
          }
        }
      ],
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/font/OpenSans-VariableFont.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Open-Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/font/OpenSans-VariableFont.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/font/OpenSans-VariableFont.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
