{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
        "noTailwindRestyledComponents": "error",
        "noTailwindRawColors": "error",
        "noTailwindArbitraryValue": "error"
      }
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"tailwind": {
    "stylesheet": "./src/global.css",
    "mergeFunctions": ["cn"],
    "variantFunctions": ["cn"],
    "attributes": ["className"]
  },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
